# 复制成 .env 后按需修改：cp deploy/compose/.env.example deploy/compose/.env
# 所有变量都给了默认值，不创建 .env 也能直接 up。

# ── 镜像版本 ──────────────────────────────
# IMAGE_PREFIX/TAG 只在“从 registry 拉预构建镜像”时有意义；
# 当前 compose 里同时写了 build:，本地执行 up --build 会先构建再打上这个 tag。
IMAGE_PREFIX=aspnetcorecloud
TAG=latest

# ── 端口（宿主:容器）───────────────────────
# 刻意避开 80/443/3306/5432 等易冲突端口
GATEWAY_PORT=10000
AUTH_PORT=10100
ORDER_PORT=10200
PRODUCT_PORT=10300
NACOS_PORT=18848
DASHBOARD_PORT=18888
DASHBOARD_OTLP_GRPC_PORT=18889
DASHBOARD_OTLP_HTTP_PORT=18890

# ── 基础设施版本 ───────────────────────────
NACOS_TAG=v2.5.4-slim
ASPIRE_TAG=13.6.0

# Nacos 鉴权：demo 默认 false。改成 true 后还需自行初始化管理员账号，
# 并给每个服务补 Nacos__UserName / Nacos__Password
NACOS_AUTH_ENABLE=false

# ── 资源上限（小内存机器可往下调）─────────────
NACOS_JVM_XMS=256m
NACOS_JVM_XMX=256m
NACOS_JVM_XMN=128m
NACOS_MEM_LIMIT=640m
DASHBOARD_MEM_LIMIT=256m
SERVICE_MEM_LIMIT=384m
