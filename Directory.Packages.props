<Project>

  <!--
    中央包管理（CPM）：所有 PackageReference 不再写 Version，版本号只在这里维护一处。
    新增依赖时：先在这里加 <PackageVersion>，再到具体工程写 <PackageReference Include="..." />。
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!-- 服务注册/发现：全仓库只有 ServiceDiscovery.Nacos 引用它 -->
    <PackageVersion Include="nacos-sdk-csharp" Version="1.3.10" />

    <!-- 反向代理网关 -->
    <PackageVersion Include="Yarp.ReverseProxy" Version="2.3.0" />

    <!-- JWT 鉴权：版本跟随 ASP.NET Core 运行时（10.0.x） -->
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
  </ItemGroup>

</Project>
