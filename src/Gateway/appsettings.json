{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://0.0.0.0:10000",
  "Service": {
    "Name": "gateway"
  },
  "Deployment": {
    "Mode": "standalone"
  },
  "Observability": {
    "Enabled": true,
    "OtlpEndpoint": ""
  },
  "Nacos": {
    "ServerAddresses": [
      "http://localhost:8848"
    ],
    "Namespace": "",
    "GroupName": "DEFAULT_GROUP",
    "ClusterName": "DEFAULT",
    "Scheme": "http",
    "UseSubscribeCache": false,
    "PreferredNetworks": [
      "192.168.",
      "10.",
      "172."
    ],
    "NamingUseRpc": false
  },
  "Gateway": {
    "Services": [
      "auth",
      "order",
      "product"
    ],
    "RoutePrefix": "/api",
    "RefreshIntervalSeconds": 5,
    "LoadBalancingPolicy": "RoundRobin",
    "EnableActiveHealthCheck": true,
    "HealthCheckPath": "/health/ready",
    "HealthCheckIntervalSeconds": 5,
    "AnonymousPaths": [
      "/api/auth"
    ],
    "RateLimitPermitLimit": 200,
    "RateLimitWindowSeconds": 1,
    "EnableDemoTokenEndpoint": true
  },
  "Jwt": {
    "Issuer": "AspNetCoreCloud",
    "Audience": "AspNetCoreCloud.Api",
    "Key": "AspNetCoreCloud-Demo-Jwt-Key-Replace-Me-In-Production-0123456789abcdef"
  },
  "ReverseProxy": {
    "Routes": [
      {
        "RouteId": "product-fallback",
        "ClusterId": "product",
        "Match": {
          "Path": "/api/product/{**catch-all}"
        }
      },
      {
        "RouteId": "order-fallback",
        "ClusterId": "order",
        "Match": {
          "Path": "/api/order/{**catch-all}"
        }
      },
      {
        "RouteId": "auth-fallback",
        "ClusterId": "auth",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      }
    ],
    "Clusters": {
      "product": {
        "Destinations": {
          "product-local": {
            "Address": "http://localhost:10300"
          }
        }
      },
      "order": {
        "Destinations": {
          "order-local": {
            "Address": "http://localhost:10200"
          }
        }
      },
      "auth": {
        "Destinations": {
          "auth-local": {
            "Address": "http://localhost:10100"
          }
        }
      }
    }
  }
}
